{
    "$schema": "https://json.schemastore.org/prettierrc",
    "tabWidth": 4,
    "useTabs": false,
    "jsxSingleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "singleAttributePerLine": true,
    "printWidth": 120,
    "singleQuote": true,
    "endOfLine": "auto",
    "overrides": [
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
